{
  "name": "notype",
  "version": "1.1.0",
  "description": "AI Voice typing tool inspired by Typeless",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.changyiwu.notype",
    "productName": "noType",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/app_icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "noType"
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}
